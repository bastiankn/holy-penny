{
  "name": "holy-penny",
  "version": "1.0.0",
  "description": "WebAR Coin Game - A browser-based augmented reality coin collection game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test:deploy": "node --test scripts/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test -- --runInBand && npm run test:deploy"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jest": "^29.5.11",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.160.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samis0707/holy-penny.git"
  },
  "keywords": [
    "webar",
    "threejs",
    "augmented-reality",
    "game"
  ],
  "author": "",
  "license": "MIT"
}
